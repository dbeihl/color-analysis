{
  "name": "color-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --disableConsoleIntercept",
    "derive": ".venv/bin/python scripts/derive-palettes.py",
    "derive:check": ".venv/bin/python scripts/derive-palettes.py --check"
  },
  "dependencies": {
    "culori": "4.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "28.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
